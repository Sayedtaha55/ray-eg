{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "strict": true,

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@ray-eg/shared": ["packages/shared/src/index.ts"],
      "@ray-eg/shared/*": ["packages/shared/src/*"],
      "@/*": ["packages/shared/src/*"],
      "@core/*": ["backend/src/core/*"],
      "@shared/*": ["packages/shared/src/*"],
      "@assets/*": ["packages/shared/src/assets/*"],
      "@common/*": ["backend/src/common/*"],
      "@modules/*": ["backend/src/modules/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}

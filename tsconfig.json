{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "strict": true,

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@ray-eg/shared": ["packages/shared/src/index.ts"],
      "@ray-eg/shared/*": ["packages/shared/src/*"],
      "@/*": ["packages/shared/src/*", "src/shared/*"],
      "@core/*": ["src/core/*", "backend/src/core/*"],
      "@features/*": ["src/features/*", "apps/marketplace/src/features/*"],
      "@shared/*": ["packages/shared/src/*", "src/shared/*", "backend/src/shared/*"],
      "@assets/*": ["packages/shared/src/assets/*", "src/assets/*"],
      "@common/*": ["backend/src/common/*"],
      "@modules/*": ["backend/src/modules/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}

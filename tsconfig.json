{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@ray-eg/shared": ["packages/shared/src/index.ts"],
      "@ray-eg/shared/*": ["packages/shared/src/*"],
      "@/*": ["packages/shared/src/*"],
      "@shared/*": ["packages/shared/src/*"],
      "@assets/*": ["packages/shared/src/assets/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "scripts/**/*",
    "test/**/*",
    "*.ts",
    "*.tsx",
    "*.js",
    "*.mjs"
  ],
  "exclude": [
    "_archive",
    "node_modules",
    "dist",
    ".next",
    "gobackend",
    "saas-backend",
    "prisma"
  ]
}

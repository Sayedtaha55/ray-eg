APP_ENV=development
APP_NAME=saas-backend
APP_PORT=8080

# Uses the existing PostgreSQL container (ray-postgres-dev) on port 5433
DB_HOST=localhost
DB_PORT=5433
DB_USER=ray_user
DB_PASSWORD=ray_password
DB_NAME=saas_db
DB_URL=postgres://ray_user:ray_password@localhost:5433/saas_db?sslmode=disable

# Uses the existing Redis container (ray-redis-dev) on port 6379
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiter: requests per minute per IP
RATE_LIMIT_RPM=100

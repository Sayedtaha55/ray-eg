# Application
APP_ENV=development
APP_NAME=ray-backend-go
APP_VERSION=0.1.0
PORT=4000
HOST=0.0.0.0
FRONTEND_APP_URL=http://localhost:5174

# Database (PostgreSQL)
DATABASE_URL=postgresql://ray_user:ray_password@localhost:5433/ray_marketplace?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MIGRATE_ON_BOOT=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth & Security
JWT_SECRET=dev-secret-32-chars-long-minimum
ADMIN_BOOTSTRAP_TOKEN=change-this-to-secure-random-string-in-production
ALLOW_DEV_ADMIN_BOOT=true
ALLOW_DEV_MERCHANT_BOOT=true
ALLOW_DEV_COURIER_BOOT=true
CSRF_DISABLED=true
CORS_ORIGIN=http://localhost:5174

# Logging
LOG_LEVEL=info
LOG_FORMAT=console

# Media / External
# Local development option: start MinIO with `docker compose up -d minio`
# and use the values below. Production should use Cloudflare R2 or AWS S3.
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=ray_minio
S3_SECRET_ACCESS_KEY=ray_minio_dev_password
S3_BUCKET=ray-media
S3_PUBLIC_BASE_URL=http://localhost:9000/ray-media

# Search
ELASTICSEARCH_URL=http://localhost:9200

# Web Push Notifications (VAPID)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# ============================================================
# PRODUCTION ENV — Supabase + Redis
# ============================================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to git
# ============================================================

# App
APP_ENV=production
APP_NAME=ray-backend-go
APP_VERSION=1.0.0
PORT=4000
HOST=0.0.0.0
FRONTEND_APP_URL=https://your-frontend-domain.com

# ── Database (Supabase) ──────────────────────────────────────
# Get from: Supabase → Project Settings → Database → URI
# Use "Session mode" (port 5432) not "Transaction mode"
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m
DB_MIGRATE_ON_BOOT=false

# ── Redis ────────────────────────────────────────────────────
# Use Upstash (free) or Railway Redis
# Upstash: https://upstash.com → Create Database → REST URL
REDIS_URL=redis://default:[PASSWORD]@[HOST]:[PORT]

# ── Auth & Security ──────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
ADMIN_BOOTSTRAP_TOKEN=CHANGE_THIS_TO_SECURE_RANDOM_STRING
CSRF_DISABLED=false
CORS_ORIGIN=https://your-frontend-domain.com

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Storage (Cloudflare R2 or AWS S3) ───────────────────────
# Cloudflare R2 (recommended — free 10GB):
# R2 → Create Bucket → API Tokens → Create Token
S3_REGION=auto
S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
S3_BUCKET=ray-media
S3_PUBLIC_BASE_URL=https://media.your-domain.com

# ── Email (SMTP) ─────────────────────────────────────────────
# Resend (free 3000/month): https://resend.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=YOUR_RESEND_API_KEY
SMTP_FROM=noreply@your-domain.com
SMTP_FROM_NAME=Ray

# ── Web Push Notifications (VAPID) ──────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@your-domain.com
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

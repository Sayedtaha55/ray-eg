{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist-electron",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"],
    "types": ["electron", "node"]
  },
  "include": ["main.ts", "preload.ts"]
}

# ----------------------------------------------------------------
# EXAMPLE ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your actual values.
# ----------------------------------------------------------------

# --- Application ---
NODE_ENV=development

MEDIA_STORAGE_MODE=local

PORT=4000
BACKEND_PORT=4000

# --- Database (PostgreSQL via Docker) ---
# Start with: docker compose up -d
DATABASE_URL="postgresql://ray_user:ray_password@localhost:5433/ray_marketplace?sslmode=disable"

# --- JWT Configuration ---
# Generate a strong secret (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECURITY: Never commit a real secret. Use a secrets manager in production.
JWT_SECRET=change-this-to-a-random-32-char-minimum-secret
JWT_EXPIRES_IN=7d

# --- URLs ---
# Marketplace (Next.js) URL — public-facing app for SEO
MARKETPLACE_URL=http://localhost:5174
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4000
# Dashboard (Next.js) URL — merchant/admin/courier app
DASHBOARD_URL=http://localhost:3000
# Business portal (Next.js) URL — merchant-facing app
BUSINESS_URL=http://localhost:1000
# URL the backend uses to redirect back to the frontend (marketplace by default)
FRONTEND_APP_URL=http://localhost:5174
# CORS: allow requests from all frontend apps
CORS_ORIGIN=http://localhost:5174,http://localhost:3000,http://localhost:1000,http://127.0.0.1:5174,http://127.0.0.1:3000

# --- Dev bootstrap flags (development only — all disabled by default in production) ---
AUTO_APPROVE_MERCHANTS_IN_DEV="false"
ALLOW_DEV_ADMIN_BOOTSTRAP="false"
ALLOW_DEV_MERCHANT_BOOTSTRAP="false"
ALLOW_DEV_COURIER_BOOTSTRAP="false"

DEV_COURIER_EMAIL="dev-courier@ray.local"
DEV_COURIER_NAME="Dev Courier"
DEV_COURIER_PHONE="01000000001"

# --- Redis (Docker setup) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Admin Bootstrap (use once in production to create the first admin account) ---
# POST /api/v1/auth/bootstrap-admin  { "token": "<value>", "email": "...", "password": "..." }
# SECURITY: Set to a long random string. Do NOT reuse across environments.
ADMIN_BOOTSTRAP_TOKEN=change-this-to-a-secure-random-string-in-production
# Set to true only when you need to re-run / reset admin bootstrap
ADMIN_BOOTSTRAP_ALLOW_RESET=false

# --- Rate Limiting ---
GLOBAL_RATE_LIMIT_MAX=10000
BODY_LIMIT=50mb

# --- Media / S3 (optional — uses local MinIO by default in dev) ---
# S3_REGION=auto
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=ray_minio
# S3_SECRET_ACCESS_KEY=ray_minio_dev_password
# S3_BUCKET=ray-media
# S3_PUBLIC_BASE_URL=http://localhost:9000/ray-media

# --- Search / Elasticsearch (optional) ---
# ELASTICSEARCH_URL=http://localhost:9200

# --- AI / Gemini (optional) ---
# AI_ENABLED=false
# GEMINI_API_KEY=

# --- Push Notifications / VAPID (optional) ---
# Generate keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- Email / SMTP (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=Ray

# --- Monitoring (optional) ---
# OTEL_ENABLED=false
# JAEGER_ENDPOINT=http://localhost:14268/api/traces
# GRAFANA_PASSWORD=admin

# --- Sentry (optional) ---
# SENTRY_DSN=

# --- Frontend (Next.js apps) ---
# Auth cookie mode: set to true when the backend sets httpOnly session cookies
# (preferred for security). Falls back to localStorage Bearer token when false.
VITE_ENABLE_BEARER_TOKEN=true
VITE_API_URL=http://localhost:4000/api/v1
VITE_API_TIMEOUT_MS=15000

# --- Production Domains (fill in when deploying) ---
# MARKETPLACE_URL=https://yourdomain.com
# DASHBOARD_URL=https://dashboard.yourdomain.com
# CORS_ORIGIN=https://yourdomain.com,https://dashboard.yourdomain.com

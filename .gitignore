# ============================================================
# .gitignore - Ray Marketplace (organized & comprehensive)
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build / Dist ---
build/
dist/
dist-backend/
dist-electron/
out/
dev-dist/
release/
.next/

# --- Environment / Secrets ---
.env
.env.local
.env*.local
.env*.production
!.env.example
!.env.production.example
*.pem
*.pfx
*.p12
*.key
certs/localhost.crt
apps/marketplace-next/certificates/

# --- Logs ---
*.log
*.pid
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
reports/i18n-dashboard-report.csv
/logs-*.txt

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.cursor/

# --- Cache / Tool folders ---
.cache/
.parcel-cache/
.esbuild-cache/
.turbo/
.vite/
.vercel

# --- Package manager ---
pnpm-lock.yaml
.pnpm/

# --- Testing / Coverage ---
coverage/
*.test
*.out

# --- Database local ---
*.sqlite
*.db
prisma/dev.db
backend/prisma/dev.db

# --- Go backend ---
gobackend/bin/
gobackend/*.exe
gobackend/vendor/
gobackend/go.work
gobackend/go.work.sum

# --- Binaries / Runtime junk ---
*.exe

# --- Uploads / Generated media ---
uploads/
public/videos/

# --- Temp / Token files ---
temp_*.json

# --- Archive (old NestJS code, not tracked) ---
_archive/

# --- AI tool directories ---
.yoyo/
.qodo/
.opencode/
.windsurf/
.ai/
.devin/

# --- Test artifacts ---
testsprite_tests/

# --- Cline checkpoint junk (mangled names) ---
*clineproceed*

# Accidental shell/log artifacts (cleanup)
*.log'
*.tmp
buildcheck.txt
build_err.txt
temp-ppar
tatus --short

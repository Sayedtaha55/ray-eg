# ============================================================
# .gitignore - Ray Marketplace (organized & comprehensive)
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build / Dist ---
build/
dist/
dist-backend/
dist-electron/
out/
dev-dist/
release/
.next/

# --- Environment / Secrets ---
.env
.env.local
.env*.local
.env*.production
!.env.example
!.env.production.example
*.pem
*.pfx
*.p12
*.key
certs/localhost.crt
apps/marketplace-next/certificates/

# --- Logs ---
*.log
*.log'
*.pid
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
reports/i18n-dashboard-report.csv
/logs-*.txt
# App-specific log files (root & apps)
api_bg_err.log
backend.log
gobackend-run.log
gobackend-err.log
dev-dashboard.log
dev-marketplace.log
dev-business.log
dev-all.log
apps/business/business-dev.log
apps/dashboard-web/*.log
apps/marketplace-next/*.log

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.cursor/

# --- Cache / Tool folders ---
.cache/
.parcel-cache/
.esbuild-cache/
.turbo/
.vite/
.vercel

# --- Package manager ---
pnpm-lock.yaml
.pnpm/

# --- Testing / Coverage ---
coverage/
*.test
*.out

# --- TypeScript build info ---
*.tsbuildinfo
next-env.d.ts.bak

# --- Database local ---
*.sqlite
*.db
prisma/dev.db
backend/prisma/dev.db

# --- Go backend ---
gobackend/bin/
gobackend/*.exe
gobackend/vendor/
gobackend/go.work
gobackend/go.work.sum

# --- Binaries / Runtime junk ---
*.exe

# --- Uploads / Generated media ---
uploads/
public/videos/

# --- Temp / Token files ---
temp_*.json

# --- Archive (old NestJS code, not tracked) ---
_archive/

# --- AI tool directories ---
.yoyo/
.qodo/
.opencode/
.windsurf/
.ai/
.devin/

# --- Test artifacts ---
testsprite_tests/

# --- Cline checkpoint junk (mangled names) ---
*clineproceed*

# Accidental shell/log artifacts (cleanup)
*.log'
*.tmp
buildcheck.txt
build_err.txt
temp-ppar
tatus --short

# --- Ad-hoc probe/analysis artifacts at repo root ---
*-paths.txt
*-calls.tsv
*-out.txt
probe-*.txt
mkt-err.log
mkt-out.log

gobackend/NUL

# browser test artifacts (regenerated by scripts/browser-test-import-export.js)
scripts/browser-test-out/

# ZCode local config (contains MCP API keys)
.zcode/config.json

# backup litter
*.old-backup
testsprite_tests/tmp/
testsprite_tests/tmp/config.json

# --- API (Go backend) ---
# Used by the production build only; `next dev` proxies /api/* through the
# rewrite in next.config.mjs instead.
NEXT_PUBLIC_BACKEND_URL=https://api2.mnmknk.com
NEXT_PUBLIC_API_URL=https://api2.mnmknk.com

# --- Cross-app: merchant dashboard (dashboard-web) ---
# This app hands a new merchant to the dashboard right after signup. Leave it
# unset and production falls back to the live dashboard deployment; setting it
# to a localhost URL on a deployed environment strands merchants on their own
# machine, so only use localhost for local development.
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard-web-three-kappa.vercel.app
